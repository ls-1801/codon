import internal.static as static

class object:
    def __init__(self):
        pass

    def __repr__(self) -> str:
        return f"<{self.__class__.__name__} object at {self.__raw__()}>"

def id(x) -> int:
    if isinstance(x, ByRef):
        return int(x.__raw__())
    else:
        return 0

def print(*args, sep: str = " ", end: str = "\n", file=_C.seq_stdout(), flush: bool = False):
    fp = cobj()
    if isinstance(file, cobj):
        fp = file
    else:
        fp = file.fp
    i = 0
    for a in args:
        if i and sep:
            _C.seq_print_full(sep, fp)
        _C.seq_print_full(str(a), fp)
        i += 1
    _C.seq_print_full(end, fp)
    if flush:
        _C.fflush(fp)

def input(prompt: str = ""):
    stdout = _C.seq_stdout()
    stderr = _C.seq_stderr()
    stdin = _C.seq_stdin()
    _C.fflush(stderr)
    _C.fflush(stdout)
    print(prompt, end="")
    buf = cobj()
    n = 0
    s = _C.getline(__ptr__(buf), __ptr__(n), stdin)
    if s > 0:
        if buf[s - 1] == byte(10):
            s -= 1  # skip trailing '\n'
        if s != 0 and buf[s - 1] == byte(13):
            s -= 1  # skip trailing '\r'
        ans = str(buf, s).__ptrcopy__()
        _C.free(buf)
        return ans
    else:
        _C.free(buf)
        raise EOFError("EOF when reading a line")

@extend
class __internal__:
    def print(*args):
        print(*args, flush=True, file=_C.seq_stdout())

def min(*args, key=None, default=None):
    if static.len(args) == 0:
        compile_error("min() expected at least 1 argument, got 0")
    elif static.len(args) > 1 and default is not None:
        compile_error("min() 'default' argument only allowed for iterables")
    elif static.len(args) == 1:
        x = args[0].__iter__()
        if not x.done():
            s = x.__next__()
            while not x.done():
                i = x.__next__()
                if key is None:
                    if i < s:
                        s = i
                else:
                    if key(i) < key(s):
                        s = i
            x.destroy()
            return s
        else:
            x.destroy()
        if default is None:
            raise ValueError("min() arg is an empty sequence")
        else:
            return default
    elif static.len(args) == 2:
        a, b = args
        if key is None:
            return a if a <= b else b
        else:
            return a if key(a) <= key(b) else b
    else:
        m = args[0]
        for i in args[1:]:
            if key is None:
                if i < m:
                    m = i
            else:
                if key(i) < key(m):
                    m = i
        return m

def max(*args, key=None, default=None):
    if static.len(args) == 0:
        compile_error("max() expected at least 1 argument, got 0")
    elif static.len(args) > 1 and default is not None:
        compile_error("max() 'default' argument only allowed for iterables")
    elif static.len(args) == 1:
        x = args[0].__iter__()
        if not x.done():
            s = x.__next__()
            while not x.done():
                i = x.__next__()
                if key is None:
                    if i > s:
                        s = i
                else:
                    if key(i) > key(s):
                        s = i
            x.destroy()
            return s
        else:
            x.destroy()
        if default is None:
            raise ValueError("max() arg is an empty sequence")
        else:
            return default
    elif static.len(args) == 2:
        a, b = args
        if key is None:
            return a if a >= b else b
        else:
            return a if key(a) >= key(b) else b
    else:
        m = args[0]
        for i in args[1:]:
            if key is None:
                if i > m:
                    m = i
            else:
                if key(i) > key(m):
                    m = i
        return m

def len(x) -> int:
    return x.__len__()

def iter(x):
    return x.__iter__()

def abs(x):
    return x.__abs__()

def hash(x) -> int:
    return x.__hash__()

def ord(s: str) -> int:
    if len(s) != 1:
        raise TypeError(
            f"ord() expected a character, but string of length {len(s)} found"
        )
    return int(s.ptr[0])

def divmod(a, b):
    if hasattr(a, "__divmod__"):
        return a.__divmod__(b)
    else:
        return (a // b, a % b)

def chr(i: int) -> str:
    p = cobj(1)
    p[0] = byte(i)
    return str(p, 1)

def next(g: Generator[T], default: Optional[T] = None, T: type) -> T:
    if g.done():
        if default is not None:
            return default.__val__()
        else:
            raise StopIteration()
    return g.__next__()

def any(x: Generator[T], T: type) -> bool:
    for a in x:
        if a:
            return True
    return False

def all(x: Generator[T], T: type) -> bool:
    for a in x:
        if not a:
            return False
    return True

def zip(*args):
    if static.len(args) == 0:
        yield from List[int]()
    else:
        iters = tuple(iter(i) for i in args)
        done = False
        while not done:
            for i in iters:
                if i.done():
                    done = True
            if not done:
                yield tuple(i.__next__() for i in iters)
        for i in iters:
            i.destroy()

def filter(f: CallableTrait[[T], bool], x: Generator[T], T: type) -> Generator[T]:
    for a in x:
        if f(a):
            yield a

def map(f, *args):
    if static.len(args) == 0:
        compile_error("map() expects at least one iterator")
    elif static.len(args) == 1:
        for a in args[0]:
            yield f(a)
    else:
        for a in zip(*args):
            yield f(*a)

def enumerate(x, start: int = 0):
    i = start
    for a in x:
        yield (i, a)
        i += 1

def echo(x):
    print x
    return x

def reversed(x):
    if hasattr(x, "__reversed__"):
        return x.__reversed__()


    def _rev(x):
        i = x.__len__() - 1
        while i >= 0:
            yield x[i]
            i -= 1

    return _rev(x)

# NebulaStream: Python's round. round(x) of a float is an int, and ties go to the even value. round(x, n) of a float is
# a float, correctly rounded from the exact value of x (2.675 is below 2.675 in binary, so round(2.675, 2) is 2.67).
# round of an int is an int. Codon's int has 64 bits: a result outside of it raises OverflowError, where Python gives a
# larger int.
def _round_float_to_int(x: float) -> int:
    if x != x:
        raise ValueError("cannot convert float NaN to integer")
    r = x.rint()
    if r - r != 0.0 or r >= 9223372036854775808.0 or r < -9223372036854775808.0:
        raise OverflowError("cannot convert float infinity to integer" if r - r != 0.0 else
                            "rounded value too large for a 64-bit int")
    return r.__int__()

def _round_float(x: float, n: int) -> float:
    r = _C.nes_float_round(x, n)
    if r - r != 0.0 and x - x == 0.0:
        raise OverflowError("rounded value too large to represent")
    return r

def _round_int(x: int, n: int) -> int:
    if n >= 0:
        return x
    if n < -19:
        return 0
    if n == -19:
        # |x| < 9.3e18: the result is 0, or 10**19, which does not fit (5e18 is a tie and goes to 0).
        if x > 5000000000000000000 or x < -5000000000000000000:
            raise OverflowError("rounded value too large for a 64-bit int")
        return 0
    p = 1
    for _ in range(-n):
        p *= 10
    q = x // p
    r = x - q * p
    if 2 * r > p or (2 * r == p and q % 2 != 0):
        q += 1
    if q > 9223372036854775807 // p or q < -9223372036854775808 // p:
        raise OverflowError("rounded value too large for a 64-bit int")
    return q * p

def round(x, n=None):
    if isinstance(x, float):
        if isinstance(n, NoneType) or isinstance(n, Optional[NoneType]):
            return _round_float_to_int(x)
        else:
            return _round_float(x, n.__index__())
    elif isinstance(x, int) or isinstance(x, bool):
        if isinstance(n, NoneType) or isinstance(n, Optional[NoneType]):
            return int(x)
        else:
            return _round_int(int(x), n.__index__())
    elif hasattr(x, "__round__"):
        if isinstance(n, NoneType) or isinstance(n, Optional[NoneType]):
            return x.__round__()
        else:
            return x.__round__(n)
    else:
        compile_error("round() of an unsupported type")

def sum(x, start=0):
    if ((isinstance(x, List[int]) and isinstance(start, int)) or
        (isinstance(x, List[int]) and isinstance(start, float)) or
        (isinstance(x, List[float]) and isinstance(start, float))):
        p = x.arr.ptr
        s = start
        for i in range(len(x)):
            s += p[i]
        return s
    elif isinstance(x, List[float]) and isinstance(start, int):
        p = x.arr.ptr
        s = float(start)
        for i in range(len(x)):
            s += p[i]
        return s
    elif isinstance(x, List[bool]) and isinstance(start, int):
        p = x.arr.ptr
        s = start
        for i in range(len(x)):
            s += 1 if p[i] else 0
        return s
    if ((isinstance(x, Generator[int]) and isinstance(start, int)) or
        (isinstance(x, Generator[int]) and isinstance(start, float)) or
        (isinstance(x, Generator[float]) and isinstance(start, float))):
        s = start
        for a in x:
            s += a
        return s
    elif isinstance(x, Generator[float]) and isinstance(start, int):
        s = float(start)
        for a in x:
            s += a
        return s
    elif isinstance(x, Generator[bool]) and isinstance(start, int):
        s = start
        for a in x:
            s += 1 if a else 0
        return s
    else:
        itr = x.__iter__()
        S = type(start + itr.__promise__()[0])
        if isinstance(start, S):
            s = start
        else:
            s = S(start)

        for a in x:
            s = s + a

        return s

def __nes_unpack__(x):
    # NES: unpacking (`a, b = x`) indexes x; an iterable without __getitem__ (a generator, map(...)) becomes a list.
    if hasattr(x, "__getitem__"):
        return x
    else:
        return list(x)

def ascii(x):
    """NES: repr(x) with every non-ASCII character escaped as \\xNN, \\uNNNN or \\UNNNNNNNN, as Python's ascii()."""
    r = repr(x)
    n = r.len  # bytes: len() and slicing may count code points (NES unicode plugin)
    p = r.ptr
    i = 0
    plain = True
    while i < n:
        if int(p[i]) >= 128:
            plain = False
            break
        i += 1
    if plain:
        return r
    out = ""
    start = 0
    hexdigits = "0123456789abcdef"
    while i < n:
        b = int(p[i])
        if b < 128:
            i += 1
            continue
        out += str(p + start, i - start)
        if b >= 0xF0 and i + 3 < n:
            cp = ((b & 0x07) << 18) | ((int(p[i + 1]) & 0x3F) << 12) | ((int(p[i + 2]) & 0x3F) << 6) | (int(p[i + 3]) & 0x3F)
            i += 4
        elif b >= 0xE0 and i + 2 < n:
            cp = ((b & 0x0F) << 12) | ((int(p[i + 1]) & 0x3F) << 6) | (int(p[i + 2]) & 0x3F)
            i += 3
        elif b >= 0xC0 and i + 1 < n:
            cp = ((b & 0x1F) << 6) | (int(p[i + 1]) & 0x3F)
            i += 2
        else:
            cp = b
            i += 1
        if cp < 0x100:
            out += "\\x" + hexdigits[cp >> 4] + hexdigits[cp & 15]
        elif cp < 0x10000:
            out += "\\u"
            for sh in (12, 8, 4, 0):
                out += hexdigits[(cp >> sh) & 15]
        else:
            out += "\\U"
            for sh in (28, 24, 20, 16, 12, 8, 4, 0):
                out += hexdigits[(cp >> sh) & 15]
        start = i
        while i < n and int(p[i]) < 128:
            i += 1
    out += str(p + start, n - start)
    return out

def repr(x):
    if not hasattr(x, "__repr__") and hasattr(x, "__repr_default__"):
        return x.__repr_default__()
    return x.__repr__()

def _int_format(a: int, base: int, prefix: str = ""):
    assert base == 2 or base == 8 or base == 10 or base == 16
    chars = "0123456789abcdef-"

    # The digits come from the magnitude as an unsigned integer: // on a negative int rounds toward negative infinity
    # with Python numerics and never reaches 0, and -a overflows for the smallest int.
    m = u64(a) if a >= 0 else u64(0) - u64(a)
    ubase = u64(base)
    b = m
    digits = 0
    while b != u64(0):
        digits += 1
        b //= ubase

    sz = digits + (1 if a <= 0 else 0) + len(prefix)
    p = Ptr[byte](sz)
    q = p

    if a < 0:
        q[0] = chars[-1].ptr[0]
        q += 1

    if prefix:
        str.memcpy(q, prefix.ptr, len(prefix))
        q += len(prefix)

    if digits != 0:
        b = m
        q += digits - 1
        while b != u64(0):
            q[0] = chars.ptr[int(b % ubase)]
            q += -1
            b //= ubase
    else:
        q[0] = chars.ptr[0]

    return str(p, sz)

def bin(n):
    return _int_format(n.__index__(), 2, "0b")

def oct(n):
    return _int_format(n.__index__(), 8, "0o")

def hex(n):
    return _int_format(n.__index__(), 16, "0x")

def pow(base: float, exp: float):
    return base ** exp

@overload
def pow(base: int, exp: int, mod: Optional[int] = None):
    if exp < 0:
        raise ValueError("pow() negative int exponent not supported")

    if mod is not None:
        if mod == 0:
            raise ValueError("pow() 3rd argument cannot be 0")
        base %= mod

    result = 1
    while exp > 0:
        if exp & 1:
            x = result * base
            result = x % mod if mod is not None else x
        y = base * base
        base = y % mod if mod is not None else y
        exp >>= 1
    return result % mod if mod is not None else result

@extend
class int:
    def _from_str(s: str, base: int):
        def parse_error(s: str, base: int):
            raise ValueError(
                f"invalid literal for int() with base {base}: {s.__repr__()}"
            )

        if base < 0 or base > 36 or base == 1:
            raise ValueError("int() base must be >= 2 and <= 36, or 0")

        s0 = s
        base0 = base
        s = s.strip()
        n = len(s)
        negate = False

        if base == 0:
            # skip leading sign
            o = 0
            if n >= 1 and (s.ptr[0] == byte(43) or s.ptr[0] == byte(45)):
                o = 1

            # detect base from prefix
            if n >= o + 1 and s.ptr[o] == byte(48):  # '0'
                if n < o + 2:
                    parse_error(s0, base)

                if s.ptr[o + 1] == byte(98) or s.ptr[o + 1] == byte(66):  # 'b'/'B'
                    base = 2
                elif s.ptr[o + 1] == byte(111) or s.ptr[o + 1] == byte(79):  # 'o'/'O'
                    base = 8
                elif s.ptr[o + 1] == byte(120) or s.ptr[o + 1] == byte(88):  # 'x'/'X'
                    base = 16
                else:
                    parse_error(s0, base)
            else:
                base = 10

        if base == 2 or base == 8 or base == 16:
            if base == 2:
                C_LOWER = byte(98)  # 'b'
                C_UPPER = byte(66)  # 'B'
            elif base == 8:
                C_LOWER = byte(111)  # 'o'
                C_UPPER = byte(79)   # 'O'
            else:
                C_LOWER = byte(120)  # 'x'
                C_UPPER = byte(88)   # 'X'

            def check_digit(d: byte, base: int):
                if base == 2:
                    return d == byte(48) or d == byte(49)
                elif base == 8:
                    return byte(48) <= d <= byte(55)
                elif base == 16:
                    return ((byte(48) <= d <= byte(57)) or
                            (byte(97) <= d <= byte(102)) or
                            (byte(65) <= d <= byte(70)))
                return False

            if (n >= 4 and
                (s.ptr[0] == byte(43) or s.ptr[0] == byte(45)) and
                s.ptr[1] == byte(48) and
                (s.ptr[2] == C_LOWER or s.ptr[2] == C_UPPER)):  # '+0b' etc.
                if not check_digit(s.ptr[3], base):
                    parse_error(s0, base0)
                negate = (s.ptr[0] == byte(45))
                s = str(s.ptr + 3, n - 3)
            elif (n >= 3 and
                  s.ptr[0] == byte(48) and
                  (s.ptr[1] == C_LOWER or s.ptr[1] == C_UPPER)):  # '0b' etc.
                if not check_digit(s.ptr[3], base):
                    parse_error(s0, base0)
                s = str(s.ptr + 2, n - 2)

        end = cobj()
        result = _C.seq_int_from_str(s, __ptr__(end), i32(base))
        # NES: s.len counts bytes, as end does; len(s) counts code points where str is Unicode-aware.
        n = s.len

        if n == 0 or end != s.ptr + n:
            parse_error(s0, base0)

        if negate:
            result = -result

        return result

@extend
class float:
    def _from_str(s: str) -> float:
        s0 = s
        s = s.rstrip()
        # NES: s.len counts bytes, as end does; len(s) counts code points where str is Unicode-aware.
        n = s.len
        end = cobj()
        result = _C.seq_float_from_str(s, __ptr__(end))

        if n == 0 or end != s.ptr + n:
            raise ValueError(f"could not convert string to float: {s0.__repr__()}")

        return result

@extend
class complex:
    def _from_str(v: str) -> complex:
        def parse_error():
            raise ValueError("complex() arg is a malformed string")

        n = len(v)
        s = v.ptr
        x = 0.0
        y = 0.0
        z = 0.0
        got_bracket = False
        end = cobj()
        i = 0

        while i < n and str._isspace(s[i]):
            i += 1

        if i < n and s[i] == byte(40):  # '('
            got_bracket = True
            i += 1
            while i < n and str._isspace(s[i]):
                i += 1

        z = _C.seq_float_from_str(str(s + i, n - i), __ptr__(end))

        if end != s + i:
            i = end - s

            if i < n and (s[i] == byte(43) or s[i] == byte(45)):  # '+' '-'
                x = z
                y = _C.seq_float_from_str(str(s + i, n - i), __ptr__(end))

                if end != s + i:
                    i = end - s
                else:
                    y = 1.0 if s[i] == byte(43) else -1.0
                    i += 1

                if not (i < n and (s[i] == byte(106) or s[i] == byte(74))):  # 'j' 'J'
                    parse_error()

                i += 1
            elif i < n and (s[i] == byte(106) or s[i] == byte(74)):  # 'j' 'J'
                i += 1
                y = z
            else:
                x = z
        else:
            if i < n and (s[i] == byte(43) or s[i] == byte(45)):  # '+' '-'
                y = 1.0 if s[i] == byte(43) else -1.0
                i += 1
            else:
                y = 1.0

            if not (i < n and (s[i] == byte(106) or s[i] == byte(74))):  # 'j' 'J'
                parse_error()

            i += 1

        while i < n and str._isspace(s[i]):
            i += 1

        if got_bracket:
            if i < n and s[i] != byte(41):  # ')'
                parse_error()
            i += 1
            while i < n and str._isspace(s[i]):
                i += 1

        if i != n:
            parse_error()

        return complex(x, y)

@extend
class float32:
    def _from_str(s: str) -> float32:
        return float32(float._from_str(s))

@extend
class float16:
    def _from_str(s: str) -> float16:
        return float16(float._from_str(s))

@extend
class bfloat16:
    def _from_str(s: str) -> bfloat16:
        return bfloat16(float._from_str(s))

@extend
class complex64:
    def _from_str(s: str) -> complex64:
        return complex64(complex._from_str(s))

def _jit_display(x, s: Literal[str], bundle: Optional[Set[str]] = None):
    if isinstance(x, None):
        return
    if hasattr(x, "_repr_mimebundle_") and s == "jupyter":
        d = x._repr_mimebundle_(bundle)
        # TODO: pick appropriate mime
        mime = next(d.keys()) # just pick first
        print(f"\x00\x00__codon/mime__\x00{mime}\x00{d[mime]}", end='')
    elif hasattr(x, "__repr__"):
        print(x.__repr__(), end='')
    elif hasattr(x, "__str__"):
        print(x.__str__(), end='')


# NES: the value of a parameter whose default is None after `if p is None: p = E` (see the scoping visitor's
# nesRebindNoneDefaults). `make` computes E. For an argument that is always None (the default) the result is E's type; for
# an Optional argument it is checked at run time; any other argument is returned as it is.
def __nes_none_default__(arg, make):
    if isinstance(arg, NoneType):
        return make()
    elif isinstance(arg, Optional):
        return __nes_none_default_optional__(arg, make)
    else:
        return arg


def __nes_none_default_optional__(arg: Optional[T], make, T: type):
    if T is NoneType:
        return make()
    else:
        if arg is None:
            return make()
        return arg.__val__()


# NES: `p or E` for a parameter whose default is None.
def __nes_or_default__(arg, make):
    if isinstance(arg, NoneType):
        return make()
    elif isinstance(arg, Optional):
        return __nes_or_default_optional__(arg, make)
    else:
        return arg if arg else make()


def __nes_or_default_optional__(arg: Optional[T], make, T: type):
    if T is NoneType:
        return make()
    else:
        if arg is None:
            return make()
        value = arg.__val__()
        return value if value else make()


# NES: a variable after a None test that rules None out (see the scoping visitor's NesNarrowing): the value of an
# Optional, any other value as it is.
def __nes_narrow__(x):
    if isinstance(x, Optional):
        return x.__val__()
    else:
        return x
