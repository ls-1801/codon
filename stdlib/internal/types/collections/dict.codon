# dict implementation that keeps insertion order, with the layout of CPython's compact dict:
# - _keys, _vals and _hashes are dense entry arrays in insertion order. A deleted entry has the hash _DELETED and
#   stays in place until the next rebuild, so iteration skips it and the order of the others does not change.
# - _index is the hash table: open addressing with triangular probing over _n_buckets (a power of two) slots. A slot
#   holds an entry number, _EMPTY, or _DUMMY (its entry was deleted; probing continues past it).
# The entry number is the "slot" that _kh_get and _kh_put give, so callers index _keys and _vals with it as before.
# _capacity entries fit before a rebuild, two thirds of _n_buckets, so the index always has an empty slot.

import internal.gc as gc

def _dict_hash(key) -> int:
    k = key.__hash__()
    # Non-negative, so that _DELETED cannot be the hash of a key. The index uses the low bits only.
    return ((k >> 33) ^ k ^ (k << 11)) & 0x7FFFFFFFFFFFFFFF

_EMPTY: Literal[int] = -1
_DUMMY: Literal[int] = -2
_DELETED: Literal[int] = -1
_MIN_BUCKETS: Literal[int] = 8

def _dict_buckets_for(n: int) -> int:
    # The smallest power of two with at least n slots and at least _MIN_BUCKETS.
    b = _MIN_BUCKETS
    while b < n:
        b <<= 1
    return b

class Dict:
    _n_buckets: int  # slots in _index; 0 before the first insertion
    _size: int       # entries that are not deleted
    _n_entries: int  # entries in use, deleted ones included
    _capacity: int   # entries that fit in _keys, _vals and _hashes
    _fill: int       # slots in _index that are not _EMPTY

    _index: Ptr[int]
    _hashes: Ptr[int]
    _keys: Ptr[K]
    _vals: Ptr[V]

    K: type = NoneType
    V: type = NoneType

    # Magic methods

    def _init(self):
        self._n_buckets = 0
        self._size = 0
        self._n_entries = 0
        self._capacity = 0
        self._fill = 0
        self._index = Ptr[int]()
        self._hashes = Ptr[int]()
        self._keys = Ptr[K]()
        self._vals = Ptr[V]()

    def _init_from(self, other):
        if other._size == 0:
            self._init()
            return
        if other._n_entries != other._size:
            # Copy without the deleted entries. Insertion keeps the order.
            self._init()
            self._kh_rebuild(other._n_buckets)
            for k, v in other.items():
                self[k] = v
            return

        n = other._n_buckets
        c = other._capacity
        e = other._n_entries
        self._n_buckets = n
        self._size = other._size
        self._n_entries = e
        self._capacity = c
        self._fill = other._fill
        self._index = Ptr[int](n)
        self._hashes = Ptr[int](c)
        self._keys = Ptr[K](c)
        self._vals = Ptr[V](c)
        str.memcpy(self._index.as_byte(), other._index.as_byte(), n * gc.sizeof(int))
        str.memcpy(self._hashes.as_byte(), other._hashes.as_byte(), e * gc.sizeof(int))
        str.memcpy(self._keys.as_byte(), other._keys.as_byte(), e * gc.sizeof(K))
        str.memcpy(self._vals.as_byte(), other._vals.as_byte(), e * gc.sizeof(V))

    def __init__(self):
        self._init()

    def __init__(self, g: Generator[Tuple[K, V]]):
        self._init()
        for k, v in g:
            self[k] = v

    def __init__(self, other: Dict[K, V]):
        self._init_from(other)

    def __getitem__(self, key: K) -> V:
        x = self._kh_get(key)
        if x != self._kh_end():
            return self._vals[x]
        raise KeyError(str(key))

    def __setitem__(self, key: K, val: V):
        ret, x = self._kh_put(key)
        self._vals[x] = val

    def __delitem__(self, key: K):
        x = self._kh_get(key)
        if x != self._kh_end():
            self._kh_del(x)
        else:
            raise KeyError(str(key))

    # NES: an empty dict or set whose element type no use fixed (`set([])` after `p = []` for a parameter whose default
    # is None) has the element type NoneType. Only None can be an element, so a value of another type is never one. The
    # typed method below wins whenever it applies (Codon resolves overloads bottom-up).
    def __contains__(self, key) -> bool:
        if K is NoneType:
            return False
        else:
            compile_error("dict.__contains__: the key has another type than the keys")

    def __contains__(self, key: K) -> bool:
        return self._kh_get(key) != self._kh_end()

    def __eq__(self, other: Dict[K, V]) -> bool:
        if self.__len__() != other.__len__():
            return False
        for k, v in self.items():
            if k not in other or other[k] != v:
                return False
        return True

    def __ne__(self, other: Dict[K, V]) -> bool:
        return not (self == other)

    def __iter__(self) -> Generator[K]:
        return self.keys()

    def __reversed__(self) -> Generator[K]:
        i = self._n_entries - 1
        while i >= 0:
            if self._hashes[i] != _DELETED:
                yield self._keys[i]
            i -= 1

    def __len__(self) -> int:
        return self._size

    def __or__(self, other):
        new = self.__copy__()
        new.update(other)
        return new

    def __ior__(self, other):
        self.update(other)
        return self

    def __copy__(self):
        d = Dict[K, V]()
        d._init_from(self)
        return d

    def __deepcopy__(self) -> Dict[K, V]:
        return {k.__deepcopy__(): v.__deepcopy__() for k, v in self.items()}

    def __repr__(self) -> str:
        n = self.__len__()
        if n == 0:
            return "{}"
        else:
            buf = _strbuf()
            buf.append("{")
            first = True
            for k, v in self.items():
                if not first:
                    buf.append(", ")
                else:
                    first = False
                buf.append(k.__repr__())
                buf.append(": ")
                buf.append(v.__repr__())
            buf.append("}")
            return buf.__str__()

    # Helper methods

    def __bool__(self):
        return self.__len__() > 0

    def resize(self, new_n_buckets: int):
        # Reserve room: grows the table to at least new_n_buckets slots, never shrinks it.
        if new_n_buckets > self._n_buckets:
            self._kh_rebuild(_dict_buckets_for(new_n_buckets))

    def get(self, key: K, s: V) -> V:
        return self._get_or(key, s)

    @overload
    def get(self, key: K, s: Optional[NoneType]) -> Optional[V]:
        # NES: d.get(k, None) (a None literal is an Optional[NoneType]) is d.get(k). get(key, s: V) converted the None
        # default to V when the call was made, which raised even for a present key. The annotated result type lets
        # Codon type the variable that takes the result as Optional[V] before it realizes this function.
        return self.get(key)

    @overload
    def get(self, key: K, s: D, D: type):
        # NES: a default of another type than the values (`ranks.get(pair, float('inf'))` on an int dict): the result
        # is a value or the default, as in Python. Only when D is not V and not None (the overloads above).
        O = Union[V, D]
        x = self._kh_get(key)
        if x != self._kh_end():
            return O(self._vals[x])
        return O(s)

    def _get_or(self, key: K, s: V) -> V:
        x = self._kh_get(key)
        return self._vals[x] if x != self._kh_end() else s

    def get(self, key: K) -> Optional[V]:
        x = self._kh_get(key)
        return self._vals[x] if x != self._kh_end() else None

    def setdefault(self, key: K, val: V) -> V:
        ret, x = self._kh_put(key)
        if ret != 0:  # i.e. key not present
            self._vals[x] = val
            return val
        return self._vals[x]

    def increment(self, key: K, by: T = 1, T: type):
        ret, x = self._kh_put(key)
        if ret != 0:  # i.e. key not present
            self._vals[x] = by
        else:
            self._vals[x] += by

    def __dict_do_op_throws__(self, key: K, other: Z, op: F, F: type, Z: type):
        x = self._kh_get(key)
        if x == self._kh_end():
            raise KeyError(str(key))
        else:
            self._vals[x] = op(self._vals[x], other)

    def __dict_do_op__(self, key: K, other: Z, dflt: V, op: F, F: type, Z: type):
        ret, x = self._kh_put(key)
        self._vals[x] = op(dflt if ret != 0 else self._vals[x], other)

    def update(self, other):
        if isinstance(other, Dict[K, V]):
            for k, v in other.items():
                self[k] = v
        else:
            for k, v in other:
                self[k] = v

    def update(self, other: Dict[K, V]):
        for k, v in other.items():
            self[k] = v

    def pop(self, key: K) -> V:
        x = self._kh_get(key)
        if x != self._kh_end():
            v = self._vals[x]
            self._kh_del(x)
            return v
        raise KeyError(str(key))

    def pop(self, key: K, default: V) -> V:
        x = self._kh_get(key)
        if x != self._kh_end():
            v = self._vals[x]
            self._kh_del(x)
            return v
        return default

    def popitem(self) -> Tuple[K, V]:
        # Last in, first out, as in Python.
        i = self._n_entries - 1
        while i >= 0 and self._hashes[i] == _DELETED:
            i -= 1
        if i < 0:
            raise KeyError("popitem(): dictionary is empty")
        item = (self._keys[i], self._vals[i])
        self._kh_del(i)
        # The entries from i on are deleted. Their _index slots stay _DUMMY and count in _fill.
        self._n_entries = i
        return item

    def clear(self):
        self._kh_clear()

    def items(self) -> Generator[Tuple[K, V]]:
        i = 0
        while i < self._n_entries:
            if self._hashes[i] != _DELETED:
                yield self._keys[i], self._vals[i]
            i += 1

    def keys(self) -> Generator[K]:
        for k, _ in self.items():
            yield k

    def values(self) -> Generator[V]:
        for _, v in self.items():
            yield v

    def copy(self):
        return self.__copy__()

    def fromkeys(ks: Generator[K], v: V, K: type, V: type) -> Dict[K, V]:
        return {k: v for k in ks}

    # Internal helpers. A "slot" in the names below is an entry number: _kh_end() means "no entry", and the entries
    # from _kh_begin() to _kh_end() for which _kh_exist() is true are the items in insertion order.

    def _kh_clear(self):
        i = 0
        while i < self._n_buckets:
            self._index[i] = _EMPTY
            i += 1
        self._size = 0
        self._n_entries = 0
        self._fill = 0

    def _kh_get(self, key: K) -> int:
        if self._size == 0:
            return self._n_entries
        h = _dict_hash(key)
        mask = self._n_buckets - 1
        i = h & mask
        step = 0
        while True:
            ix = self._index[i]
            if ix == _EMPTY:
                return self._n_entries
            if ix >= 0 and self._hashes[ix] == h and self._keys[ix] == key:
                return ix
            step += 1
            i = (i + step) & mask

    def _kh_rebuild(self, new_n_buckets: int):
        # Drops the deleted entries (the others keep their order), sizes the entry arrays for new_n_buckets and
        # builds _index again from the stored hashes. new_n_buckets is a power of two with room for _size entries.
        j = 0
        i = 0
        while i < self._n_entries:
            h = self._hashes[i]
            if h != _DELETED:
                if i != j:
                    self._hashes[j] = h
                    self._keys[j] = self._keys[i]
                    self._vals[j] = self._vals[i]
                j += 1
            i += 1
        self._n_entries = j

        new_capacity = (new_n_buckets << 1) // 3
        if new_capacity != self._capacity:
            self._hashes = Ptr[int](
                gc.realloc(self._hashes.as_byte(),
                           new_capacity * gc.sizeof(int),
                           self._capacity * gc.sizeof(int))
            )
            self._keys = Ptr[K](
                gc.realloc(self._keys.as_byte(),
                           new_capacity * gc.sizeof(K),
                           self._capacity * gc.sizeof(K))
            )
            self._vals = Ptr[V](
                gc.realloc(self._vals.as_byte(),
                           new_capacity * gc.sizeof(V),
                           self._capacity * gc.sizeof(V))
            )
            self._capacity = new_capacity

        if new_n_buckets != self._n_buckets:
            self._index = Ptr[int](new_n_buckets)
            self._n_buckets = new_n_buckets
        mask = new_n_buckets - 1
        i = 0
        while i < new_n_buckets:
            self._index[i] = _EMPTY
            i += 1
        e = 0
        while e < j:
            s = self._hashes[e] & mask
            step = 0
            while self._index[s] != _EMPTY:
                step += 1
                s = (s + step) & mask
            self._index[s] = e
            e += 1
        self._size = j
        self._fill = j

    def _kh_resize(self, new_n_buckets: int):
        self.resize(new_n_buckets)

    def _kh_put(self, key: K) -> Tuple[int, int]:
        # Returns (0, entry) if key is present, else appends an entry for key (its value is not set) and returns
        # (1, entry).
        h = _dict_hash(key)
        mask = self._n_buckets - 1
        slot = -1
        if self._n_buckets:
            i = h & mask
            step = 0
            while True:
                ix = self._index[i]
                if ix == _EMPTY:
                    if slot < 0:
                        slot = i
                    break
                if ix == _DUMMY:
                    if slot < 0:
                        slot = i
                elif self._hashes[ix] == h and self._keys[ix] == key:
                    return (0, ix)
                step += 1
                i = (i + step) & mask

        reuses_dummy = slot >= 0 and self._index[slot] == _DUMMY
        if self._n_entries >= self._capacity or (not reuses_dummy and self._fill >= self._capacity):
            # Grow to three times the live size, as CPython; many deletions can also shrink the table.
            self._kh_rebuild(_dict_buckets_for(3 * (self._size + 1)))
            mask = self._n_buckets - 1
            slot = h & mask
            step = 0
            while self._index[slot] != _EMPTY:
                step += 1
                slot = (slot + step) & mask
            reuses_dummy = False

        x = self._n_entries
        self._index[slot] = x
        self._hashes[x] = h
        self._keys[x] = key
        self._n_entries = x + 1
        self._size += 1
        if not reuses_dummy:
            self._fill += 1
        return (1, x)

    def _kh_del(self, x: int):
        if x < 0 or x >= self._n_entries:
            return
        h = self._hashes[x]
        if h == _DELETED:
            return
        mask = self._n_buckets - 1
        i = h & mask
        step = 0
        while self._index[i] != x:
            step += 1
            i = (i + step) & mask
        self._index[i] = _DUMMY
        self._hashes[x] = _DELETED
        self._size -= 1

    def _kh_begin(self) -> int:
        return 0

    def _kh_end(self) -> int:
        return self._n_entries

    def _kh_exist(self, x: int) -> bool:
        return self._hashes[x] != _DELETED

dict = Dict
